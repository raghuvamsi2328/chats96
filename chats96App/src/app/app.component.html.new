<div class="app-container">
  <!-- Header Bar -->
  <header class="app-header">
    <div class="header-content">
      <div class="app-title">
        <span style="font-size: 1.5em;">💬</span>
        <h1>chats96</h1>
      </div>
      <button (click)="toggleTheme()" class="theme-toggle">
        <span *ngIf="theme() === 'light-theme'">🌙</span>
        <span *ngIf="theme() === 'dark-theme'">☀️</span>
        <span class="theme-text">{{ theme() === 'light-theme' ? 'Dark' : 'Light' }}</span>
      </button>
    </div>
  </header>

  <!-- Loading Spinner -->
  <div *ngIf="isLoading" class="loading-overlay">
    <div class="loading-spinner">
      <div class="spinner"></div>
      <p>Loading room information...</p>
    </div>
  </div>

  <!-- Main Content Area -->
  <main class="main-content">
    <!-- Welcome/Setup Screen -->
    <div *ngIf="!isChatActive && !showPinDialog && !showCreateRoomForm" class="welcome-screen">
      <div class="welcome-card">
        <div class="welcome-header">
          <div class="welcome-icon">💬</div>
          <h2>Welcome to chats96</h2>
          <p>Secure, real-time messaging with room protection</p>
        </div>

        <!-- Room Info (if joining existing room) -->
        <div *ngIf="roomInfo" class="room-info-card">
          <div class="room-header">
            <h3>{{ roomInfo.roomTitle || 'Chat Room' }}</h3>
            <div class="room-meta">
              <span class="created-by">{{ roomInfo.createdBy }}</span>
              <span class="active-users">{{ roomInfo.activeUsers }} active users</span>
            </div>
          </div>
          <div class="room-details">
            <div class="detail-item" *ngIf="roomInfo.requiresPin">
              <span class="detail-icon">🔒</span>
              <span>PIN Protected</span>
            </div>
            <div class="detail-item" *ngIf="roomInfo.expiresAt">
              <span class="detail-icon">⏰</span>
              <span>Expires {{ roomInfo.expiresAt | date:'short' }}</span>
            </div>
          </div>
        </div>

        <div class="setup-form">
          <!-- Name Input -->
          <div class="input-group">
            <label for="chatNameInput" class="input-label">Your Name</label>
            <input
              id="chatNameInput"
              type="text"
              [(ngModel)]="chatName"
              placeholder="Enter your display name"
              class="form-input"
              maxlength="100"
              (keyup.enter)="chatRoomKey ? joinExistingChat() : (showCreateRoomForm = true)"
            />
          </div>

          <!-- Action Buttons -->
          <div class="action-buttons">
            <button 
              *ngIf="!chatRoomKey"
              (click)="showCreateRoomForm = true"
              class="btn btn-primary"
              [disabled]="!chatName.trim()"
            >
              <span class="btn-icon">➕</span>
              Create New Room
            </button>

            <button 
              *ngIf="chatRoomKey"
              (click)="joinExistingChat()"
              class="btn btn-primary"
              [disabled]="!chatName.trim()"
            >
              <span class="btn-icon">🚪</span>
              Join Room
            </button>
          </div>

          <!-- Error Message -->
          <div *ngIf="errorMessage" class="error-message">
            <span class="error-icon">⚠️</span>
            {{ errorMessage }}
          </div>

          <!-- Status -->
          <div class="status-message">
            {{ currentStatus }}
          </div>
        </div>
      </div>
    </div>

    <!-- Create Room Form -->
    <div *ngIf="showCreateRoomForm" class="modal-overlay" (click)="closeCreateForm()">
      <div class="modal-content" (click)="$event.stopPropagation()">
        <div class="modal-header">
          <h3>Create New Room</h3>
          <button (click)="closeCreateForm()" class="close-btn">✕</button>
        </div>

        <div class="create-form">
          <!-- Room Title -->
          <div class="input-group">
            <label for="roomTitleInput" class="input-label">Room Title</label>
            <input
              id="roomTitleInput"
              type="text"
              [(ngModel)]="roomTitle"
              placeholder="Enter room title"
              class="form-input"
              maxlength="100"
            />
          </div>

          <!-- Room PIN (Optional) -->
          <div class="input-group">
            <label for="roomPinInput" class="input-label">
              Room PIN (Optional)
              <span class="label-hint">🔒 Protects your room</span>
            </label>
            <input
              id="roomPinInput"
              type="text"
              [(ngModel)]="roomPin"
              placeholder="Enter 4-10 digit PIN"
              class="form-input"
              maxlength="10"
            />
          </div>

          <!-- Expiry Date (Optional) -->
          <div class="input-group">
            <label for="expiryInput" class="input-label">
              Expiry Date (Optional)
              <span class="label-hint">⏰ Auto-delete after this date</span>
            </label>
            <input
              id="expiryInput"
              type="datetime-local"
              [(ngModel)]="expiresAt"
              class="form-input"
              [min]="minDateTime"
            />
          </div>

          <!-- Persistent Room Toggle -->
          <div class="input-group">
            <label class="checkbox-label">
              <input
                type="checkbox"
                [(ngModel)]="isPersistent"
                class="checkbox-input"
              />
              <span class="checkbox-text">Keep room alive when empty</span>
            </label>
          </div>

          <!-- Action Buttons -->
          <div class="modal-actions">
            <button 
              (click)="closeCreateForm()"
              class="btn btn-secondary"
            >
              Cancel
            </button>
            <button 
              (click)="createNewChat()"
              class="btn btn-primary"
              [disabled]="!roomTitle.trim() || !chatName.trim() || isCreatingRoom"
            >
              <span *ngIf="isCreatingRoom" class="btn-spinner">⏳</span>
              <span *ngIf="!isCreatingRoom" class="btn-icon">🚀</span>
              {{ isCreatingRoom ? 'Creating...' : 'Create Room' }}
            </button>
          </div>
        </div>
      </div>
    </div>

    <!-- PIN Verification Dialog -->
    <div *ngIf="showPinDialog" class="modal-overlay" (click)="closePinDialog()">
      <div class="modal-content pin-dialog" (click)="$event.stopPropagation()">
        <div class="modal-header">
          <h3>🔒 Enter Room PIN</h3>
          <button (click)="closePinDialog()" class="close-btn">✕</button>
        </div>

        <div class="pin-form">
          <p class="pin-description">
            This room is protected. Please enter the PIN to join.
          </p>

          <div class="input-group">
            <input
              type="password"
              [(ngModel)]="enteredPin"
              placeholder="Enter PIN"
              class="form-input pin-input"
              maxlength="10"
              (keyup.enter)="verifyPinAndJoin()"
              autofocus
            />
          </div>

          <div class="modal-actions">
            <button 
              (click)="closePinDialog()"
              class="btn btn-secondary"
            >
              Cancel
            </button>
            <button 
              (click)="verifyPinAndJoin()"
              class="btn btn-primary"
              [disabled]="!enteredPin.trim()"
            >
              <span class="btn-icon">🔓</span>
              Join Room
            </button>
          </div>

          <div *ngIf="errorMessage" class="error-message">
            <span class="error-icon">⚠️</span>
            {{ errorMessage }}
          </div>
        </div>
      </div>
    </div>

    <!-- Chat Interface -->
    <div *ngIf="isChatActive" class="chat-interface">
      <!-- Chat Header -->
      <div class="chat-top-bar">
        <div class="room-info">
          <div class="room-details">
            <h3>{{ roomInfo?.roomTitle || chatRoomKey }}</h3>
            <span class="user-name">{{ chatName }}</span>
            <div class="room-meta" *ngIf="roomInfo">
              <span *ngIf="roomInfo.requiresPin" class="room-badge">🔒 Protected</span>
              <span *ngIf="roomInfo.expiresAt" class="room-badge">⏰ Expires</span>
            </div>
          </div>
        </div>
        <div class="chat-actions">
          <button (click)="shareChatRoom()" class="share-button">
            <span class="btn-icon">🔗</span>
            <span class="share-text">Share</span>
          </button>
        </div>
      </div>

      <!-- Chat Window -->
      <div class="chat-window-container">
        <app-chat-window
          [chatRoomKey]="chatRoomKey!"
          [chatName]="chatName">
        </app-chat-window>
      </div>
    </div>
  </main>
</div>
